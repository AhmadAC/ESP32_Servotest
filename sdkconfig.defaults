CONFIG_IDF_TARGET="esp32s3"

# Primary Console on USB Serial / JTAG (YD-ESP32-S3 Native USB port @ 115200 baud)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS 1000Hz tick rate
CONFIG_FREERTOS_HZ=1000

# Compiler Optimization for Size (-Os)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# HTTP Server Buffer Settings & URI handlers for Captive Portal
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512

# Flash & Custom Partition Table for Large Embedded Audio Binaries
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"